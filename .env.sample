# iOS remote notifications via APNs.
# Copy these into your deployment environment and fill Apple Developer values.
APNS_ENABLED=false
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_AUTH_KEY_PATH=""
APNS_AUTH_KEY=""
APNS_TOPIC="com.bansheng.dev"
APNS_USE_SANDBOX=true
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_DISPATCH_BATCH_SIZE=50
