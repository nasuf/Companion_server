DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connection_limit=5&pool_timeout=30&connect_timeout=30"
MIGRATION_DATABASE_URL="postgresql://user:password@host:6543/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
APP_ENV="development"
CORS_ALLOWED_ORIGINS=""
DB_CONNECTION_LIMIT=5
DB_MAX_CONCURRENT_QUERIES=5
DB_QUERY_MAX_RETRIES=2
REDIS_URL="redis://localhost:6379/0"

# Chat image uploads. In production, mount the host data-disk directory to
# CHAT_MEDIA_DIR inside the server container. DB rows keep only storage_key/url;
# the image bytes live on this persistent disk path.
CHAT_MEDIA_DIR="var/chat_media"
CHAT_MEDIA_PUBLIC_PREFIX="/chat/media"

# Offline activity completion photo uploads. Use a dedicated persistent disk
# directory instead of sharing chat media, so activity records can evolve
# independently from chat attachments.
OFFLINE_MEDIA_DIR="var/offline_media"
OFFLINE_MEDIA_PUBLIC_PREFIX="/offline/media"

# Time capsule uploads. In production, mount the host data-disk directory to
# CAPSULE_MEDIA_DIR inside the server container and keep DB rows on storage_key
# plus this public prefix, not physical filesystem paths.
CAPSULE_MEDIA_DIR="var/capsule_media"
CAPSULE_MEDIA_PUBLIC_PREFIX="/capsules/media"

# Local Ollama
OLLAMA_BASE_URL="http://localhost:11434"

# Alibaba Cloud Bailian / DashScope
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_ENABLE_THINKING="false"

# DeepSeek direct API
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Simple switch
ONLINE_MODEL="false"
REMOTE_PROVIDER="dashscope"

# Only four model names you normally need to care about
LOCAL_CHAT_MODEL="qwen2.5:14b"
LOCAL_SMALL_MODEL="qwen2.5:7b"
REMOTE_CHAT_MODEL="qwen3.5-plus"
REMOTE_SMALL_MODEL="qwen3.5-flash"

# Optional advanced overrides. Leave blank unless debugging a special case.
CHAT_MODEL=""
SUMMARIZER_MODEL=""
UTILITY_MODEL=""
EMBEDDING_MODEL=""
CHAT_PROVIDER=""
SUMMARIZER_PROVIDER=""
UTILITY_PROVIDER=""
EMBEDDING_PROVIDER=""
LLM_PROVIDER=""

LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_ORG_ID=""
LANGSMITH_PROJECT_ID=""

# Axiom 结构化日志 (https://app.axiom.co). 留空 → 跳过远程日志, 仅 console.
# AXIOM_LOG_LEVEL 默认 INFO; 设 DEBUG 会把 quota 打爆, 不建议.
AXIOM_TOKEN=""
AXIOM_DATASET=""
AXIOM_ORG_ID=""
AXIOM_LOG_LEVEL="INFO"

JWT_SECRET="change_me_for_local_only"

# WeChat Open Platform mobile app login. Keep AppSecret on the server only.
WECHAT_LOGIN_ENABLED=false
WECHAT_MOBILE_APP_ID=""
WECHAT_MOBILE_APP_SECRET=""
WECHAT_OAUTH_TIMEOUT_S=6

# Jamendo music integration. Create a client id from https://developer.jamendo.com.
JAMENDO_CLIENT_ID=""
JAMENDO_BASE_URL="https://api.jamendo.com/v3.0"
JAMENDO_DEFAULT_LIBRARIES="focus,ambient,sleep"

# Chat link cards and proactive link search.
# CHAT_LINK_SEARCH_PROVIDER:
#   custom -> POST CHAT_LINK_SEARCH_ENDPOINT with {query, platforms, limit}
#   tavily -> Tavily Search API
#   brave  -> Brave Web Search API
# Live provider smoke test:
#   uv run python scripts/smoke_chat_link_provider.py --query "周末咖啡 分享" --require-live
PROACTIVE_LINK_RECOMMENDATION_ENABLED=true
PROACTIVE_LINK_RECOMMENDATION_PROBABILITY=0.03
PROACTIVE_LINK_CANDIDATE_URLS=""
CHAT_LINK_SEARCH_PROVIDER="custom"
CHAT_LINK_SEARCH_ENDPOINT=""
CHAT_LINK_SEARCH_API_KEY=""
CHAT_LINK_SEARCH_TIMEOUT_S=8
TAVILY_API_KEY=""
TAVILY_SEARCH_ENDPOINT="https://api.tavily.com/search"
BRAVE_SEARCH_API_KEY=""
BRAVE_SEARCH_ENDPOINT="https://api.search.brave.com/res/v1/web/search"

# Real-world gift commerce/logistics.
# Defaults stay mock. For production, expose a server-side purchasing service:
#   POST {GIFT_COMMERCE_BASE_URL}/search
#   POST {GIFT_COMMERCE_BASE_URL}/orders
# and a tracking service:
#   POST {GIFT_LOGISTICS_BASE_URL}/tracking
# These services own marketplace-specific Taobao/ERP/payment/logistics secrets.
GIFT_COMMERCE_PROVIDER="mock" # mock | custom_http | ali1688
GIFT_COMMERCE_BASE_URL=""
GIFT_COMMERCE_API_KEY=""
GIFT_COMMERCE_TIMEOUT_S=12
GIFT_LOGISTICS_PROVIDER="mock" # mock | custom_http | ali1688
GIFT_LOGISTICS_BASE_URL=""
GIFT_LOGISTICS_API_KEY=""
GIFT_LOGISTICS_TIMEOUT_S=10

# 1688 开放平台采购接入：把上面两个 PROVIDER 都设为 "ali1688" 后启用。
#   ALI1688_APP_KEY / ALI1688_APP_SECRET：在 open.1688.com 创建应用后获得（企业账号 + 诚信通）。
#   ALI1688_ACCESS_TOKEN：OAuth 授权采购账号后获得，会过期，需用 refresh_token 定期续期。
# 前置条件：企业实名 + 诚信通 + 交易类 API 权限审核 + 已签「先采后付/免密代扣」协议（否则无法自动付款）。
ALI1688_APP_KEY=""
ALI1688_APP_SECRET=""
ALI1688_ACCESS_TOKEN=""      # 初始值；之后由 cron 刷新写入 Redis，运行时优先读 Redis
ALI1688_REFRESH_TOKEN=""     # OAuth 授权得到，cron 每 6h 用它换新 access_token
ALI1688_SEARCH_RECALL=40
ALI1688_REQUIRE_ONE_PIECE=true

# iOS remote notifications via APNs.
# Use APNS_AUTH_KEY_PATH in production; APNS_AUTH_KEY is a local/dev fallback
# where newlines may be encoded as \n.
APNS_ENABLED=false
APNS_TEAM_ID=""
APNS_KEY_ID=""
APNS_AUTH_KEY_PATH=""
APNS_AUTH_KEY=""
APNS_TOPIC="com.bansheng.dev"
APNS_USE_SANDBOX=true
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_DISPATCH_BATCH_SIZE=50

ARK_API_KEY=""
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_VISION_MODEL=doubao-1-5-vision-pro-32k-250115
