datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "extensions")]
}

generator client {
  provider             = "prisma-client-py"
  previewFeatures      = ["postgresqlExtensions"]
  recursive_type_depth = 5
}

model User {
  id                       String                          @id @default(uuid())
  username                 String                          @unique
  hashedPassword           String?                         @map("hashed_password")
  role                     String                          @default("user") @map("role")
  email                    String?                         @unique
  status                   String                          @default("active")
  archivedAt               DateTime?                       @map("archived_at")
  lastSeenAt               DateTime?                       @map("last_seen_at")
  // 用户自设的昵称与头像。此前两者只存在于 auth_identities.raw_profile
  // (provider=wechat), 手机号 / 密码账号根本没有存储位 —— 生产上 47 个用户里
  // 有 12 个改不了。这两列是所有身份类型共用的权威值, 微信 rawProfile 退化为
  // 首登时的默认来源 (见 auth._build_auth_response)。
  displayName              String?                         @map("display_name")
  // 头像文件的 storage key (services/user_avatars.py), 不是 URL: URL 前缀可随
  // 部署变化, 存 key 才能重新拼。NULL 表示没有自设头像。
  avatarKey                String?                         @map("avatar_key")
  locationLatitude         Float?                          @map("location_latitude")
  locationLongitude        Float?                          @map("location_longitude")
  locationCity             String?                         @map("location_city")
  locationRegion           String?                         @map("location_region")
  locationCountry          String?                         @map("location_country")
  locationSource           String?                         @map("location_source")
  locationPermissionStatus String?                         @map("location_permission_status")
  locationUpdatedAt        DateTime?                       @map("location_updated_at")
  // Registration-origin analytics, written once at account creation and never
  // updated by later logins. NULL for accounts created before this feature.
  signupSource             String?                         @map("signup_source")
  signupPlatform           String?                         @map("signup_platform")
  signupOsVersion          String?                         @map("signup_os_version")
  signupAppVersion         String?                         @map("signup_app_version")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  agents                   AiAgent[]
  workspaces               ChatWorkspace[]
  conversations            Conversation[]
  chatAttachments          ChatMessageAttachment[]
  chatLinkCards            ChatLinkCard[]
  profiles                 UserProfile[]
  portraits                UserPortrait[]
  profileTags              UserProfileTag[]
  memoryChangelogs         MemoryChangelog[]
  intimacies               Intimacy[]
  timeTriggers             TimeTrigger[]
  proactiveStates          ProactiveState[]
  proactiveEvents          ProactiveEventLog[]
  patienceStates           PatienceState[]
  authIdentities           AuthIdentity[]
  timeCapsules             TimeCapsule[]
  lastWills                LastWill[]
  dailyActivities          UserDailyActivity[]
  gameSessions             GameSession[]
  nativeGameSkillStates    NativeGameSkillState[]
  musicFavorites           MusicFavorite[]
  musicPlaybacks           MusicPlayback[]
  musicCoListeningSessions MusicCoListeningSession[]
  mealVoucher              MealVoucher?
  mealRedeemFailures       MealRedemptionFailure[]
  achievementUnlocks       AchievementUnlock[]
  achievementEvents        AchievementEvent[]
  pushDevices              PushDevice[]
  notificationEvents       NotificationEvent[]
  wallet                   UserWallet?
  walletLedger             WalletLedger[]
  offerings                UserOffering[]
  agentWallets             AgentWallet[]
  offlineActivities        OfflineActivityRecommendation[]
  offlineActivityFeedback  OfflineActivityFeedback[]
  offlineActivityMedia     OfflineActivityMedia[]
  giftAddresses            GiftAddress[]
  realWorldGifts           RealWorldGift[]
  realWorldTriggerStates   RealWorldTriggerState[]
  realWorldRechargeLedger  RealWorldRechargeLedger[]
  bugReportsFiled          BugReport[]                     @relation("BugReportsFiled")
  bugReportsResolved       BugReport[]                     @relation("BugReportsResolved")

  // admin 监控"新增注册走势"按 created_at 分桶.
  @@index([createdAt])
  @@map("users")
}

model AuthIdentity {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String   @map("provider_account_id")
  openid            String?
  unionid           String?
  scope             String?
  rawProfile        Json?    @map("raw_profile")
  lastLoginAt       DateTime @default(now()) @map("last_login_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId], map: "auth_identities_provider_account_unique")
  @@index([userId], map: "auth_identities_user_id_idx")
  @@index([openid], map: "auth_identities_openid_idx")
  @@index([unionid], map: "auth_identities_unionid_idx")
  @@map("auth_identities")
}

model AiAgent {
  id                       String                          @id @default(uuid())
  name                     String
  userId                   String                          @map("user_id")
  user                     User                            @relation(fields: [userId], references: [id])
  status                   String                          @default("active")
  archivedAt               DateTime?                       @map("archived_at")
  // Per spec §1.2: MBTI 是 canonical personality 表达，user 输入的 7 维仅作
  // 创建时的 transient 输入，转 MBTI 后即丢弃。
  mbti                     Json? // 初始 MBTI: {EI, NS, TF, JP, type, summary}
  currentMbti              Json?                           @map("current_mbti") // 调整后的 MBTI（同形）
  background               String?
  values                   Json?
  lifeOverview             String?                         @map("life_overview")
  age                      Int?
  occupation               String?
  city                     String?
  gender                   String?                         @map("gender")
  avatarKey                String?                         @map("avatar_key")
  avatarUrl                String?                         @map("avatar_url")
  // Stable TTS voice and per-agent synthesis controls. The admin editor writes
  // these fields directly; the speech hot path reloads them before each call.
  ttsVoiceId               String?                         @map("tts_voice_id")
  ttsRate                  Float                           @default(1.0) @map("tts_rate")
  ttsPitch                 Float                           @default(1.0) @map("tts_pitch")
  ttsVolume                Int                             @default(50) @map("tts_volume")
  ttsSeed                  Int                             @default(0) @map("tts_seed")
  ttsInstruction           String?                         @map("tts_instruction")
  ttsAutoEmotion           Boolean                         @default(true) @map("tts_auto_emotion")
  ttsEmotionScale          Float                           @default(1.0) @map("tts_emotion_scale")
  // 若该 agent 是从某个模板克隆而来, 记录源模板 agent id (用于「模板被使用次数」统计).
  sourceTemplateId         String?                         @map("source_template_id")
  // 仅模板 agent 使用: 上次「全量」知识记忆同步完成的水位 (knowledge_seed 行
  // created_at > 此值 ⇒ 后台显示"有更新的记忆未同步"). 代码侧走 raw SQL 读写,
  // 单个 agent 的灰度(canary)同步不推进水位.
  knowledgeSyncedAt        DateTime?                       @map("knowledge_synced_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  workspaces               ChatWorkspace[]
  conversations            Conversation[]
  schedules                AiDailySchedule[]
  intimacies               Intimacy[]
  proactiveLogs            ProactiveChatLog[]
  traitFeedbackLogs        TraitFeedbackLog[]
  timeTriggers             TimeTrigger[]
  proactiveStates          ProactiveState[]
  proactiveEvents          ProactiveEventLog[]
  patienceStates           PatienceState[]
  configOverride           AgentConfigOverride?
  timeCapsules             TimeCapsule[]
  lastWills                LastWill[]
  gameSessions             GameSession[]
  nativeGameSkillStates    NativeGameSkillState[]
  musicFavorites           MusicFavorite[]
  musicPlaybacks           MusicPlayback[]
  musicCoListeningSessions MusicCoListeningSession[]
  achievementUnlocks       AchievementUnlock[]
  achievementEvents        AchievementEvent[]
  profileTags              UserProfileTag[]
  offlineActivities        OfflineActivityRecommendation[]
  realWorldGifts           RealWorldGift[]
  realWorldTriggerStates   RealWorldTriggerState[]
  offerings                UserOffering[]
  wallet                   AgentWallet?

  @@index([sourceTemplateId], map: "ai_agents_source_template_idx")
  @@map("ai_agents")
}

model ChatWorkspace {
  id                       String                          @id @default(uuid())
  userId                   String                          @map("user_id")
  user                     User                            @relation(fields: [userId], references: [id])
  agentId                  String?                         @map("agent_id")
  agent                    AiAgent?                        @relation(fields: [agentId], references: [id])
  status                   String                          @default("active")
  archivedAt               DateTime?                       @map("archived_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  conversations            Conversation[]
  userMemories             UserMemory[]
  aiMemories               AiMemory[]
  profiles                 UserProfile[]
  changelogs               MemoryChangelog[]
  proactiveLogs            ProactiveChatLog[]
  proactiveState           ProactiveState?
  proactiveEvents          ProactiveEventLog[]
  timeCapsules             TimeCapsule[]
  lastWills                LastWill[]
  gameSessions             GameSession[]
  musicFavorites           MusicFavorite[]
  musicPlaybacks           MusicPlayback[]
  musicCoListeningSessions MusicCoListeningSession[]
  achievementUnlocks       AchievementUnlock[]
  achievementEvents        AchievementEvent[]
  profileTags              UserProfileTag[]
  offlineActivities        OfflineActivityRecommendation[]
  realWorldGifts           RealWorldGift[]
  realWorldTriggerState    RealWorldTriggerState?

  @@index([userId, status])
  @@index([agentId, status])
  @@map("chat_workspaces")
}

model Conversation {
  id                      String                          @id @default(uuid())
  userId                  String                          @map("user_id")
  user                    User                            @relation(fields: [userId], references: [id])
  agentId                 String                          @map("agent_id")
  agent                   AiAgent                         @relation(fields: [agentId], references: [id])
  workspaceId             String?                         @map("workspace_id")
  workspace               ChatWorkspace?                  @relation(fields: [workspaceId], references: [id])
  title                   String?
  isDeleted               Boolean                         @default(false) @map("is_deleted")
  archivedAt              DateTime?                       @map("archived_at")
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  messages                Message[]
  chatAttachments         ChatMessageAttachment[]
  chatLinkCards           ChatLinkCard[]
  proactiveLogs           ProactiveChatLog[]
  proactiveStates         ProactiveState[]
  proactiveEvents         ProactiveEventLog[]
  gameSessions            GameSession[]
  musicCoListeningSession MusicCoListeningSession?
  achievementUnlocks      AchievementUnlock[]
  achievementEvents       AchievementEvent[]
  offlineActivities       OfflineActivityRecommendation[]
  realWorldGifts          RealWorldGift[]
  offerings               UserOffering[]

  @@map("conversations")
}

model Message {
  id             String                  @id @default(uuid())
  conversationId String                  @map("conversation_id")
  conversation   Conversation            @relation(fields: [conversationId], references: [id])
  role           String // "user" or "assistant"
  content        String
  metadata       Json?
  createdAt      DateTime                @default(now()) @map("created_at")
  bugReports     BugReport[]
  attachments    ChatMessageAttachment[]
  linkCards      ChatLinkCard[]

  @@index([conversationId, createdAt(sort: Desc)])
  // admin 监控聚合 (分时段/每日活跃/句子区间/DAU-WAU-MAU) 都按 role='user' +
  // created_at 范围扫全表, 加此索引避免顺序扫.
  @@index([role, createdAt])
  @@map("messages")
}

model ChatMessageAttachment {
  id                     String       @id @default(uuid())
  userId                 String       @map("user_id")
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId         String       @map("conversation_id")
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId              String?      @map("message_id")
  message                Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind                   String       @default("image")
  name                   String?
  mime                   String
  size                   Int
  width                  Int?
  height                 Int?
  durationSeconds        Int?         @map("duration_seconds")
  storageKey             String       @unique @map("storage_key")
  url                    String
  visionStatus           String       @default("pending") @map("vision_status")
  visionSummary          String?      @map("vision_summary")
  visionError            String?      @map("vision_error")
  transcriptionStatus    String?      @map("transcription_status")
  transcriptionText      String?      @map("transcription_text")
  transcriptionModel     String?      @map("transcription_model")
  transcriptionRequestId String?      @map("transcription_request_id")
  transcriptionError     String?      @map("transcription_error")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([messageId])
  @@index([userId, messageId, createdAt])
  @@map("chat_message_attachments")
}

// Speech-to-text usage meter. One row per successful /chat/transcribe call,
// covering BOTH display modes so voice-message ("voice") and voice-to-text
// ("text") durations can be reported separately. Deliberately FK-free: it is a
// standalone ledger and must survive user/conversation deletion (and accept
// historical backfill for rows whose owners no longer exist).
model SpeechUsage {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  conversationId  String   @map("conversation_id")
  displayMode     String   @map("display_mode") // "voice" | "text"
  durationSeconds Int      @map("duration_seconds")
  model           String?
  requestId       String?  @map("request_id")
  source          String   @default("live") // "live" | "backfill"
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([displayMode, createdAt])
  @@index([userId, createdAt])
  @@map("speech_usage")
}

// Assistant text-to-speech billing ledger. Values are stored at generation
// time so later price edits do not rewrite historical cost.
model TtsUsage {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  agentId              String   @map("agent_id")
  conversationId       String?  @map("conversation_id")
  messageId            String?  @map("message_id")
  source               String   // "chat" | "proactive" | "admin_preview"
  provider             String   @default("dashscope")
  model                String
  voiceId              String   @map("voice_id")
  requestId            String?  @unique @map("request_id")
  rawCharacters        Int      @map("raw_characters")
  billableCharacters   Int      @map("billable_characters")
  durationMilliseconds Int      @map("duration_milliseconds")
  audioBytes           Int      @map("audio_bytes")
  unitPriceCny         Float    @map("unit_price_cny")
  costCny              Float    @map("cost_cny")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId])
  @@map("tts_usage")
}

model TtsVoiceProfile {
  id                 String   @id @default(uuid())
  displayName        String   @map("display_name")
  provider           String   @default("dashscope")
  model              String
  voiceId            String   @map("voice_id")
  gender             String
  source             String   // "system" | "cloned"
  enabled            Boolean  @default(true)
  providerRequestId  String?  @map("provider_request_id")
  consentConfirmedAt DateTime? @map("consent_confirmed_at")
  consentConfirmedBy String?   @map("consent_confirmed_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([provider, model, voiceId])
  @@index([model, gender, enabled])
  @@map("tts_voice_profiles")
}

model ChatLinkCard {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?      @map("message_id")
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  role           String       @default("user")
  sourceApp      String?      @map("source_app")
  sourceUrl      String       @map("source_url")
  finalUrl       String       @map("final_url")
  platform       String
  title          String
  description    String       @default("")
  author         String?
  imageUrl       String?      @map("image_url")
  contentText    String       @default("") @map("content_text")
  originalText   String       @default("") @map("original_text")
  summary        String       @default("")
  status         String       @default("ready")
  error          String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, conversationId, finalUrl, role], map: "chat_link_cards_user_conv_final_role_unique")
  @@index([conversationId, createdAt(sort: Desc)], map: "chat_link_cards_conversation_created_idx")
  @@index([userId, createdAt(sort: Desc)], map: "chat_link_cards_user_created_idx")
  @@index([messageId], map: "chat_link_cards_message_idx")
  @@index([platform, createdAt(sort: Desc)], map: "chat_link_cards_platform_created_idx")
  @@map("chat_link_cards")
}

model GameSession {
  id               String         @id @default(uuid())
  provider         String         @default("native")
  gameKey          String?        @map("game_key")
  status           String         @default("created")
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId          String         @map("agent_id")
  agent            AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId      String?        @map("workspace_id")
  workspace        ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  conversationId   String?        @map("conversation_id")
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  roomId           String         @map("room_id")
  playMode         String         @default("versus") @map("play_mode")
  difficulty       String         @default("newbie")
  aiLevel          Int            @default(1) @map("ai_level")
  userPlayer       Json           @map("user_player")
  aiPlayer         Json           @map("ai_player")
  companionReply   String?        @map("companion_reply")
  result           Json?
  durationSeconds  Int?           @map("duration_seconds")
  startedAt        DateTime?      @map("started_at")
  endedAt          DateTime?      @map("ended_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  events           GameEvent[]

  @@index([userId, createdAt(sort: Desc)], map: "game_sessions_user_created_idx")
  @@index([agentId, createdAt(sort: Desc)], map: "game_sessions_agent_created_idx")
  @@index([conversationId, createdAt(sort: Desc)], map: "game_sessions_conversation_created_idx")
  @@index([provider, gameKey, createdAt(sort: Desc)], map: "game_sessions_provider_game_created_idx")
  @@index([roomId], map: "game_sessions_room_idx")
  @@index([workspaceId, startedAt(sort: Desc)], map: "game_sessions_workspace_started_idx")
  @@map("game_sessions")
}

model GameEvent {
  id             String      @id @default(uuid())
  sessionId      String      @map("session_id")
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientEventId  String?     @map("client_event_id")
  eventType      String      @map("event_type")
  state          String?
  source         String      @default("client")
  payload        Json        @default("{}")
  companionReply String?     @map("companion_reply")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([sessionId, createdAt(sort: Desc)], map: "game_events_session_created_idx")
  // The migration creates a partial unique index for non-null client_event_id;
  // Prisma schema syntax cannot represent partial indexes.
  @@index([sessionId, clientEventId], map: "game_events_session_client_event_idx")
  @@index([eventType, createdAt(sort: Desc)], map: "game_events_type_created_idx")
  @@map("game_events")
}

model NativeGameConfig {
  gameKey            String                    @id @map("game_key")
  mode               String                    @default("adaptive")
  baseStrength       Int                       @default(50) @map("base_strength")
  minStrength        Int                       @default(20) @map("min_strength")
  maxStrength        Int                       @default(85) @map("max_strength")
  targetUserRate     Float                     @default(0.55) @map("target_user_rate")
  adjustmentWindow   Int                       @default(10) @map("adjustment_window")
  minimumGames       Int                       @default(3) @map("minimum_games")
  maximumStep        Int                       @default(5) @map("maximum_step")
  algorithmOverrides Json                      @default("{}") @map("algorithm_overrides")
  minResponseMs      Int                       @default(900) @map("min_response_ms")
  maxResponseMs      Int                       @default(1600) @map("max_response_ms")
  bannerInMs         Int                       @default(200) @map("banner_in_ms")
  bannerHoldMs       Int                       @default(600) @map("banner_hold_ms")
  bannerOutMs        Int                       @default(200) @map("banner_out_ms")
  enabled            Boolean                   @default(true)
  version            Int                       @default(1)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  versions           NativeGameConfigVersion[]

  @@map("native_game_configs")
}

model NativeGameConfigVersion {
  id          String           @id @default(uuid())
  gameKey     String           @map("game_key")
  game        NativeGameConfig @relation(fields: [gameKey], references: [gameKey], onDelete: Cascade)
  version     Int
  config      Json
  publishedAt DateTime         @default(now()) @map("published_at")

  @@unique([gameKey, version], map: "native_game_config_versions_game_version_key")
  @@index([gameKey, publishedAt(sort: Desc)], map: "native_game_config_versions_game_published_idx")
  @@map("native_game_config_versions")
}

model NativeGameSkillState {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId           String   @map("agent_id")
  agent             AiAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  gameKey           String   @map("game_key")
  effectiveStrength Int      @default(50) @map("effective_strength")
  completedGames    Int      @default(0) @map("completed_games")
  ewmaUserRate      Float?   @map("ewma_user_rate")
  wins              Int      @default(0)
  losses            Int      @default(0)
  draws             Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, agentId, gameKey], map: "native_game_skill_states_pair_game_key")
  @@index([gameKey, updatedAt(sort: Desc)], map: "native_game_skill_states_game_updated_idx")
  @@map("native_game_skill_states")
}

model MusicFavorite {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String         @map("agent_id")
  agent           AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String?        @map("workspace_id")
  workspace       ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  trackExternalId String         @map("track_external_id")
  title           String
  artist          String         @default("Jamendo")
  album           String         @default("Jamendo Library")
  library         String         @default("focus")
  audioUrl        String         @default("") @map("audio_url")
  durationSec     Int            @default(0) @map("duration_sec")
  coverKey        String         @default("music-cover-01.jpg") @map("cover_key")
  accentA         String         @default("#1f6fff") @map("accent_a")
  accentB         String         @default("#18c6c0") @map("accent_b")
  source          String         @default("jamendo")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at")
