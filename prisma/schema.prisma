// 背景, agent 创建时即时单步 LLM 生成 — services/character_generation.py).

model TimeTrigger {
  id          String    @id @default(uuid())
  aiAgentId   String    @map("ai_agent_id")
  agent       AiAgent   @relation(fields: [aiAgentId], references: [id])
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  triggerTime DateTime  @map("trigger_time")
  repeatRule  String?   @map("repeat_rule") // cron表达式，null=一次性
  actionType  String    @map("action_type") // greeting/reminder/holiday/birthday
  actionData  Json?     @map("action_data")
  isActive    Boolean   @default(true) @map("is_active")
  lastFired   DateTime? @map("last_fired")
  createdAt   DateTime  @default(now()) @map("created_at")

  // scan_triggers 主路径: scheduler 每 15s 跑一次, find_many isActive=true +
  // triggerTime in [now-1min, now+1min). 没此索引会变全表扫 (round-2 review P1).
  @@index([isActive, triggerTime])
  // scheduling.find_active_reminder_triggers / deactivate / apply_reschedule:
  // (user_id, action_type='reminder', is_active) 三元过滤. 反复 cancel/reschedule
  // 大流量场景必备.
  @@index([userId, actionType, isActive])
  // scheduling.upsert_reminder_trigger 幂等查 (按 agent + memory_id 找 existing):
  // 跟 cancel 不同, 这边按 agent_id 维度 (multi-agent 用户只查当前 agent 的).
  @@index([aiAgentId, actionType, isActive])

  @@map("time_triggers")
}

// ── Entity knowledge layer ──

model MemoryEntity {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  workspaceId     String?   @map("workspace_id")
  canonicalName   String    @map("canonical_name") // "妈妈" / "老王" / "杭州"
  aliases         String[]  @default([]) // ["妈","我妈","妈咪"]
  entityType      String    @map("entity_type") // person / place / org / pet / topic / preference / other
  role            String? // mother / colleague / hometown / ...
  mentionCount    Int       @default(0) @map("mention_count")
  lastMentionedAt DateTime? @map("last_mentioned_at")
  isArchived      Boolean   @default(false) @map("is_archived")
  metadata        Json? // 可选扩展（e.g. preference.value）
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  mentions MemoryMention[]

  @@unique([userId, workspaceId, entityType, canonicalName])
  @@index([userId, workspaceId, entityType])
  @@index([userId, workspaceId, mentionCount])
  @@index([userId, workspaceId, isArchived, lastMentionedAt])
  @@map("memory_entities")
}

model MemoryMention {
  memoryId     String       @map("memory_id")
  memorySource String       @map("memory_source") // "user" | "ai"
  entityId     String       @map("entity_id")
  entity       MemoryEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  userId       String       @map("user_id")
  workspaceId  String?      @map("workspace_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@id([memoryId, entityId])
  @@index([entityId])
  @@index([userId, workspaceId])
  @@index([memoryId])
  @@map("memory_mentions")
}

// ── Calendar / 节假日 ──
//
// 来源:
//   chinesecalendar  (CN 法定假日 + 调休, 年度数据随国务院办公厅通知发布更新)
//   nager            (国际节日, nager.date REST API)
//   local            (算法计算的国际纪念日, 妇女节/儿童节/母亲节/父亲节)
//   manual           (admin 手动录入或从老硬编码 seed 的条目, refresh 不覆盖)
//
// country_code: ISO-3166 alpha-2 (如 "CN"); "INTL" 表示无特定国家的国际纪念日.
model Holiday {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  name          String
  type          String // legal / traditional / international / custom
  countryCode   String   @default("CN") @map("country_code")
  isWorkdaySwap Boolean  @default(false) @map("is_workday_swap")
  source        String // chinesecalendar / nager / local / manual
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([date, countryCode, name])
  @@index([date])
  @@index([countryCode])
  @@index([source])
  @@map("holidays")
}

// 每条 chat 请求结束时写一行的 token 用量明细. 跟 message_traces 解耦 —
// 后者是 lazy 写 (用户点 Trace 才落库), 这张表是热路径强写, 用于后台统计概览.
model LlmUsage {
  id             String   @id @default(uuid())
  // conversation_id 可空: 非会话场景 (admin 建 agent / 每日作息 cron) 也写一行,
  // 这两类没有 conversation 归属, 用 scope 区分.
  conversationId String?  @map("conversation_id")
  // 'chat' | 'post_process' | 'proactive' | 'agent_creation' | 'schedule_cron'
  scope          String   @default("chat") @map("scope")
  agentId        String?  @map("agent_id")
  userId         String?  @map("user_id")
  // 关联到 message_traces (nullable, 不外键, 避免删 trace 级联到 usage 历史)
  traceId        String?  @map("trace_id")
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  // {"qwen3.5-flash": {"input": 1200, "output": 80}, "qwen3.5-plus": {...}}
  tokensByModel  Json     @map("tokens_by_model")
  costCny        Float    @map("cost_cny")
  callCount      Int      @map("call_count")
  // Session-level runtime health metrics, accumulated by resilience.py.
  latencyMsTotal  Int     @default(0) @map("latency_ms_total")
  latencyCount    Int     @default(0) @map("latency_count")
  failureCount    Int     @default(0) @map("failure_count")
  fallbackCount   Int     @default(0) @map("fallback_count")
  circuitOpenCount Int    @default(0) @map("circuit_open_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([agentId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("llm_usage")
}


// 全局运行时配置 (admin "系统设置" 改, prod 起后可热更换模型而无需重启).
// 单行 (id 永远=1) 设计避免 0/N 行歧义. 字段 nullable 表示 "未设, 走 env 默认".
//
// 解析顺序 (services/runtime_config.resolve_config):
//   AgentConfigOverride.field → SystemConfig.field → settings.field (env)
//
// 改动通过 services/runtime_config.invalidate_caches() 触发 lru_cache 清理,
// 下条 LLM 调用按新值重建实例; 当前流式中的 chain 仍用旧模型完成 (无中断).
model SystemConfig {
  id               Int      @id @default(1)
  onlineModel      Boolean? @map("online_model")
  remoteProvider   String?  @map("remote_provider")
  localChatModel   String?  @map("local_chat_model")
  localSmallModel  String?  @map("local_small_model")
  remoteChatModel  String?  @map("remote_chat_model")
  remoteSmallModel String?  @map("remote_small_model")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// 单 agent 模型 override. 改了只影响该 agent, 其余仍走 SystemConfig/env.
// 字段 nullable: null = 不 override, fallback 上层. embedding 不在此表 — embedding
// 跨 agent 共享 vector store, 不允许 per-agent 模型 (embedding 改了已有向量失真).
model AgentConfigOverride {
  agentId          String   @id @map("agent_id")
  onlineModel      Boolean? @map("online_model")
  remoteProvider   String?  @map("remote_provider")
  localChatModel   String?  @map("local_chat_model")
  localSmallModel  String?  @map("local_small_model")
  remoteChatModel  String?  @map("remote_chat_model")
  remoteSmallModel String?  @map("remote_small_model")
  updatedAt        DateTime @updatedAt @map("updated_at")

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_config_overrides")
}


// 模型库 — admin "系统设置 → 模型库" 维护. system_config / agent_config_overrides
// 的 chat/small 字段从这里选 identifier, remote_provider/local provider 用于消歧;
// pricing.estimate_cost_cny 也从这里取价格.
//
// 设计:
//   - identifier 是 SDK 用的 model id; 同一 provider 内唯一, 跨 provider 可重名
//   - provider 派生 local (ollama) / remote (dashscope/deepseek) 分组
//   - enabled=false 软隐藏, 不影响已配置 (现有 system_config/agent override 仍指向它)
//   - 价格 nullable + Decimal(10,4) 元/1M tokens; 本地默认 0
//   - contextWindow / notes 留 hook 给未来 prompt budget / admin 备注
//
// 暂不支持删除 — 改 enabled=false 即可. 删了被引用会让 system_config 指 "幽灵 ID".
model ModelRegistry {
  id                   String   @id @default(uuid())
  identifier           String
  displayName          String?  @map("display_name")
  provider             String   // ollama | dashscope | deepseek
  enabled              Boolean  @default(true)
  contextWindow        Int?     @map("context_window")
  // Float (≈double precision) 而非 Decimal — prisma-client-py 的 Decimal 支持是
  // experimental, 启用要全局 flag. 本场景精度需求低 (元/1M tokens 4-5 位小数足够),
  // float 单次乘法误差远小于 1 分钱, 不影响计费统计.
  inputCostPerMillion  Float?   @map("input_cost_per_million")
  outputCostPerMillion Float?   @map("output_cost_per_million")
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([provider, enabled])
  @@unique([provider, identifier])
  @@map("model_registry")
}
