//   chinesecalendar  (CN 法定假日 + 调休, 年度数据随国务院办公厅通知发布更新)
//   nager            (国际节日, nager.date REST API)
//   local            (算法计算的国际纪念日, 妇女节/儿童节/母亲节/父亲节)
//   manual           (admin 手动录入或从老硬编码 seed 的条目, refresh 不覆盖)
//
// country_code: ISO-3166 alpha-2 (如 "CN"); "INTL" 表示无特定国家的国际纪念日.
model Holiday {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  name          String
  type          String // legal / traditional / international / custom
  countryCode   String   @default("CN") @map("country_code")
  isWorkdaySwap Boolean  @default(false) @map("is_workday_swap")
  source        String // chinesecalendar / nager / local / manual
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([date, countryCode, name])
  @@index([date])
  @@index([countryCode])
  @@index([source])
  @@map("holidays")
}

// 每条 chat 请求结束时写一行的 token 用量明细. 跟 message_traces 解耦 —
// 后者是 lazy 写 (用户点 Trace 才落库), 这张表是热路径强写, 用于后台统计概览.
model LlmUsage {
  id               String   @id @default(uuid())
  // conversation_id 可空: 非会话场景 (admin 建 agent / 每日作息 cron) 也写一行,
  // 这两类没有 conversation 归属, 用 scope 区分.
  conversationId   String?  @map("conversation_id")
  // 'chat' | 'post_process' | 'proactive' | 'agent_creation' | 'schedule_cron'
  scope            String   @default("chat") @map("scope")
  agentId          String?  @map("agent_id")
  userId           String?  @map("user_id")
  // 关联到 message_traces (nullable, 不外键, 避免删 trace 级联到 usage 历史)
  traceId          String?  @map("trace_id")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  // {"qwen3.5-flash": {"input": 1200, "output": 80}, "qwen3.5-plus": {...}}
  tokensByModel    Json     @map("tokens_by_model")
  costCny          Float    @map("cost_cny")
  callCount        Int      @map("call_count")
  // Ark 联网内容插件调用次数. Billed per call (not per token) with a monthly
  // free quota, so cost cannot be folded into costCny per row — the admin
  // stats aggregate month-to-date counts against the quota instead.
  webSearchCalls   Int      @default(0) @map("web_search_calls")
  // Session-level runtime health metrics, accumulated by resilience.py.
  latencyMsTotal   Int      @default(0) @map("latency_ms_total")
  latencyCount     Int      @default(0) @map("latency_count")
  failureCount     Int      @default(0) @map("failure_count")
  fallbackCount    Int      @default(0) @map("fallback_count")
  circuitOpenCount Int      @default(0) @map("circuit_open_count")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([agentId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  // 消息列表按 trace_id 关联本轮用量 (tokens/缓存/费用挂在气泡 Trace 按钮旁)
  @@index([traceId])
  @@map("llm_usage")
}

