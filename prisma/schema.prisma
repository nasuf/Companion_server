// 本地 trace 镜像表. /traces/resolve/{message_id} 懒触发 share 后, 把
// LangSmith 的 enriched trace 树整份缓存到这里, 让 trace 详情页:
// 1. 不依赖 LangSmith 网络 (可读性 / 抽风容忍)
// 2. 不被 quota 限制 (batch trace 分析时不撞 LangSmith API 上限)
// 3. 可加 SQL 索引做趋势分析 (e.g. "哪个 prompt_key 平均耗时分位最高")
//
// 设计取舍:
// - traceId 做主键, 一条 trace 一行 (消息 → trace 是 1:1; sub_intent
//   通过 attach_to_parent 复用 parent traceId, 不另起 trace).
// - stepsJson 存 trace_enrich.enrich_steps 跑完的完整 step 数组 (含
//   inputs/outputs/decision_label/category/on_critical_path 等), 不展平
//   到列 — 字段多 + 可能演化, 列粒度太碎.
// - summaryJson 冗余存顶部 trace 摘要 (duration / tokens / message), 前端
//   常用字段不用每次解 stepsJson.
// - shareUrl 与 message.metadata.trace_url 重复, 但单独存便于按 trace 维度
//   查 (e.g. batch 分析).
model MessageTrace {
  traceId         String   @id @map("trace_id")
  conversationId  String   @map("conversation_id")
  messageId       String?  @map("message_id") // 关联 message 表; 不外键, 避免删 msg 级联
  rootMessage     String?  @map("root_message") // 用户原文 (从 trace.inputs.message)
  totalDurationMs Int?     @map("total_duration_ms")
  totalTokens     Int?     @map("total_tokens")
  llmStepCount    Int?     @map("llm_step_count")
  stepsJson       Json     @map("steps_json")
  summaryJson     Json     @map("summary_json")
  shareStatus     String   @default("pending") @map("share_status") // pending / shared / failed
  shareUrl        String?  @map("share_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("message_traces")
}

// 本地 trace 采集表 (自研替代 LangSmith 的 run 树存储).
// LocalTraceHandler 在每个 langchain run 结束时逐条写入; root run 由
// LocalTracer.enter()/close() 维护. /traces/resolve 读取本表构建与
// load_public_trace 同形的 detail (归一化 + enrich 后写 message_traces 镜像).
//
// 设计取舍:
// - 一行一个 run (而非整树一行 JSON): 后台 post_process 的 LLM run 在请求
//   结束后才完成, 逐条 insert 天然支持晚到 run, 无并发覆盖问题.
// - inputsJson/outputsJson 存 langchain dumpd 序列化结果, 与 LangSmith run
//   的 inputs/outputs 同形 — trace_enrich 指纹提取和前端渲染零改动.
// - 保留期由 scheduler 每日清理 (trace_retention_days); 被查看过的 trace
//   已物化进 message_traces 镜像, 不受清理影响.
model TraceRun {
  id                 String    @id @map("run_id") // langchain run_id (uuid)
  traceId            String    @map("trace_id")
  parentId           String?   @map("parent_id")
  name               String
  runType            String    @map("run_type") // chain / llm
  status             String    @default("running") // running / success / error
  error              String?
  startedAt          DateTime  @map("started_at")
  endedAt            DateTime? @map("ended_at")
  firstTokenAt       DateTime? @map("first_token_at")
  modelName          String?   @map("model_name")
  promptTokens       Int?      @map("prompt_tokens")
  completionTokens   Int?      @map("completion_tokens")
  totalTokens        Int?      @map("total_tokens")
  promptTokenDetails Json?     @map("prompt_token_details")
  inputsJson         Json?     @map("inputs_json")
  outputsJson        Json?     @map("outputs_json")
  extraJson          Json?     @map("extra_json")
  eventsJson         Json?     @map("events_json")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([traceId])
  @@index([createdAt])
  @@map("trace_runs")
}

