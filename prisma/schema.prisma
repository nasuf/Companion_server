datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "extensions")]
}

generator client {
  provider             = "prisma-client-py"
  previewFeatures      = ["postgresqlExtensions"]
  recursive_type_depth = 5
}

model User {
  id               String              @id @default(uuid())
  username         String              @unique
  hashedPassword   String?             @map("hashed_password")
  role             String              @default("user") @map("role")
  email            String?             @unique
  status           String              @default("active")
  archivedAt       DateTime?           @map("archived_at")
  lastSeenAt       DateTime?           @map("last_seen_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  agents           AiAgent[]
  workspaces       ChatWorkspace[]
  conversations    Conversation[]
  chatAttachments  ChatMessageAttachment[]
  profiles         UserProfile[]
  portraits        UserPortrait[]
  memoryChangelogs MemoryChangelog[]
  intimacies       Intimacy[]
  timeTriggers     TimeTrigger[]
  proactiveStates  ProactiveState[]
  proactiveEvents  ProactiveEventLog[]
  patienceStates   PatienceState[]
  authIdentities    AuthIdentity[]
  timeCapsules      TimeCapsule[]
  lastWills         LastWill[]
  dailyActivities   UserDailyActivity[]
  gameSessions      GameSession[]
  musicFavorites    MusicFavorite[]
  musicPlaybacks    MusicPlayback[]
  musicCoListeningSessions MusicCoListeningSession[]
  achievementUnlocks AchievementUnlock[]
  achievementEvents  AchievementEvent[]
  pushDevices     PushDevice[]
  notificationEvents NotificationEvent[]
  wallet          UserWallet?
  walletLedger    WalletLedger[]
  bugReportsFiled    BugReport[] @relation("BugReportsFiled")
  bugReportsResolved BugReport[] @relation("BugReportsResolved")

  @@map("users")
}

model AuthIdentity {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String   @map("provider_account_id")
  openid            String?
  unionid           String?
  scope             String?
  rawProfile        Json?    @map("raw_profile")
  lastLoginAt       DateTime @default(now()) @map("last_login_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId], map: "auth_identities_provider_account_unique")
  @@index([userId], map: "auth_identities_user_id_idx")
  @@index([openid], map: "auth_identities_openid_idx")
  @@index([unionid], map: "auth_identities_unionid_idx")
  @@map("auth_identities")
}

model AiAgent {
  id                 String              @id @default(uuid())
  name               String
  userId             String              @map("user_id")
  user               User                @relation(fields: [userId], references: [id])
  status             String              @default("active")
  archivedAt         DateTime?           @map("archived_at")
  // Per spec §1.2: MBTI 是 canonical personality 表达，user 输入的 7 维仅作
  // 创建时的 transient 输入，转 MBTI 后即丢弃。
  mbti               Json? // 初始 MBTI: {EI, NS, TF, JP, type, summary}
  currentMbti        Json?               @map("current_mbti") // 调整后的 MBTI（同形）
  background         String?
  values             Json?
  lifeOverview       String?             @map("life_overview")
  age                Int?
  occupation         String?
  city               String?
  gender             String?             @map("gender")
  avatarKey          String?             @map("avatar_key")
  avatarUrl          String?             @map("avatar_url")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  workspaces         ChatWorkspace[]
  conversations      Conversation[]
  schedules          AiDailySchedule[]
  intimacies         Intimacy[]
  proactiveLogs      ProactiveChatLog[]
  traitFeedbackLogs  TraitFeedbackLog[]
  timeTriggers       TimeTrigger[]
  proactiveStates    ProactiveState[]
  proactiveEvents    ProactiveEventLog[]
  patienceStates     PatienceState[]
  configOverride     AgentConfigOverride?
  timeCapsules        TimeCapsule[]
  lastWills           LastWill[]
  gameSessions        GameSession[]
  musicFavorites      MusicFavorite[]
  musicPlaybacks      MusicPlayback[]
  musicCoListeningSessions MusicCoListeningSession[]
  achievementUnlocks AchievementUnlock[]
  achievementEvents  AchievementEvent[]

  @@map("ai_agents")
}

model AgentAvatarCache {
  key         String   @id
  gender      String?
  contentType String   @map("content_type")
  imageBytes  Bytes    @map("image_bytes")
  sourceUrl   String   @map("source_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([gender])
  @@map("agent_avatar_cache")
}

model ChatWorkspace {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id])
  agentId         String?             @map("agent_id")
  agent           AiAgent?            @relation(fields: [agentId], references: [id])
  status          String              @default("active")
  archivedAt      DateTime?           @map("archived_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  conversations   Conversation[]
  userMemories    UserMemory[]
  aiMemories      AiMemory[]
  profiles        UserProfile[]
  changelogs      MemoryChangelog[]
  proactiveLogs   ProactiveChatLog[]
  proactiveState  ProactiveState?
  proactiveEvents ProactiveEventLog[]
  timeCapsules    TimeCapsule[]
  lastWills       LastWill[]
  gameSessions    GameSession[]
  musicFavorites  MusicFavorite[]
  musicPlaybacks  MusicPlayback[]
  musicCoListeningSessions MusicCoListeningSession[]
  achievementUnlocks AchievementUnlock[]
  achievementEvents  AchievementEvent[]

  @@index([userId, status])
  @@index([agentId, status])
  @@map("chat_workspaces")
}

model Conversation {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id])
  agentId         String              @map("agent_id")
  agent           AiAgent             @relation(fields: [agentId], references: [id])
  workspaceId     String?             @map("workspace_id")
  workspace       ChatWorkspace?      @relation(fields: [workspaceId], references: [id])
  title           String?
  isDeleted       Boolean             @default(false) @map("is_deleted")
  archivedAt      DateTime?           @map("archived_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  messages        Message[]
  chatAttachments ChatMessageAttachment[]
  proactiveLogs   ProactiveChatLog[]
  proactiveStates ProactiveState[]
  proactiveEvents ProactiveEventLog[]
  gameSessions    GameSession[]
  musicCoListeningSession MusicCoListeningSession?
  achievementUnlocks AchievementUnlock[]
  achievementEvents  AchievementEvent[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // "user" or "assistant"
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  bugReports     BugReport[]
  attachments    ChatMessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model ChatMessageAttachment {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?      @map("message_id")
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind           String       @default("image")
  name           String?
  mime           String
  size           Int
  width          Int?
  height         Int?
  storageKey     String       @unique @map("storage_key")
  url            String
  visionStatus   String       @default("pending") @map("vision_status")
  visionSummary  String?      @map("vision_summary")
  visionError    String?      @map("vision_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([messageId])
  @@index([userId, messageId, createdAt])
  @@map("chat_message_attachments")
}

model GameSession {
  id                String        @id @default(uuid())
  provider          String        @default("sud")
  status            String        @default("created")
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId           String        @map("agent_id")
  agent             AiAgent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId       String?       @map("workspace_id")
  workspace         ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  conversationId    String?       @map("conversation_id")
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  mgId              String        @map("mg_id")
  roomId            String        @map("room_id")
  playMode          String        @default("versus") @map("play_mode")
  difficulty        String        @default("newbie")
  aiLevel           Int           @default(1) @map("ai_level")
  sdkEnabled        Boolean       @default(false) @map("sdk_enabled")
  sudCode           String        @map("sud_code")
  sudCodeExpiresAt  DateTime      @map("sud_code_expires_at")
  userPlayer        Json          @map("user_player")
  aiPlayer          Json          @map("ai_player")
  companionReply    String?       @map("companion_reply")
  result            Json?
  durationSeconds   Int?          @map("duration_seconds")
  startedAt         DateTime?     @map("started_at")
  endedAt           DateTime?     @map("ended_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  events            GameEvent[]

  @@index([userId, createdAt(sort: Desc)], map: "game_sessions_user_created_idx")
  @@index([agentId, createdAt(sort: Desc)], map: "game_sessions_agent_created_idx")
  @@index([conversationId, createdAt(sort: Desc)], map: "game_sessions_conversation_created_idx")
  @@index([roomId], map: "game_sessions_room_idx")
  @@map("game_sessions")
}

model GameEvent {
  id             String      @id @default(uuid())
  sessionId      String      @map("session_id")
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType      String      @map("event_type")
  state          String?
  source         String      @default("client")
  payload        Json        @default("{}")
  companionReply String?     @map("companion_reply")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([sessionId, createdAt(sort: Desc)], map: "game_events_session_created_idx")
  @@index([eventType, createdAt(sort: Desc)], map: "game_events_type_created_idx")
  @@map("game_events")
}

model MusicFavorite {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String         @map("agent_id")
  agent           AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String?        @map("workspace_id")
  workspace       ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  trackExternalId String         @map("track_external_id")
  title           String
  artist          String         @default("Jamendo")
  album           String         @default("Jamendo Library")
  library         String         @default("focus")
  audioUrl        String         @default("") @map("audio_url")
  durationSec     Int            @default(0) @map("duration_sec")
  coverKey        String         @default("music-cover-01.jpg") @map("cover_key")
  accentA         String         @default("#1f6fff") @map("accent_a")
  accentB         String         @default("#18c6c0") @map("accent_b")
  source          String         @default("jamendo")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([userId, agentId, trackExternalId], map: "music_favorites_user_agent_track_key")
  @@index([userId, agentId, createdAt(sort: Desc)], map: "music_favorites_user_agent_created_idx")
  @@index([workspaceId, createdAt(sort: Desc)], map: "music_favorites_workspace_created_idx")
  @@map("music_favorites")
}

model MusicPlayback {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String         @map("agent_id")
  agent           AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String?        @map("workspace_id")
  workspace       ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  trackExternalId String         @map("track_external_id")
  title           String
  artist          String         @default("Jamendo")
  album           String         @default("Jamendo Library")
  library         String         @default("focus")
  audioUrl        String         @default("") @map("audio_url")
  durationSec     Int            @default(0) @map("duration_sec")
  coverKey        String         @default("music-cover-01.jpg") @map("cover_key")
  accentA         String         @default("#1f6fff") @map("accent_a")
  accentB         String         @default("#18c6c0") @map("accent_b")
  source          String         @default("jamendo")
  metadata        Json           @default("{}")
  positionSeconds Int            @default(0) @map("position_seconds")
  isPlaying       Boolean        @default(true) @map("is_playing")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([userId, agentId], map: "music_playbacks_user_agent_key")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "music_playbacks_workspace_updated_idx")
  @@map("music_playbacks")
}

model MusicCoListeningSession {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId         String         @map("agent_id")
  agent           AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId     String?        @map("workspace_id")
  workspace       ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  conversationId  String         @unique @map("conversation_id")
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status          String         @default("active")
  initiatedBy     String         @default("user") @map("initiated_by")
  trackExternalId String         @map("track_external_id")
  title           String
  artist          String         @default("Jamendo")
  album           String         @default("Jamendo Library")
  library         String         @default("focus")
  audioUrl        String         @default("") @map("audio_url")
  durationSec     Int            @default(0) @map("duration_sec")
  coverKey        String         @default("music-cover-01.jpg") @map("cover_key")
  accentA         String         @default("#1f6fff") @map("accent_a")
  accentB         String         @default("#18c6c0") @map("accent_b")
  source          String         @default("jamendo")
  metadata        Json           @default("{}")
  positionSeconds Int            @default(0) @map("position_seconds")
  isPlaying       Boolean        @default(true) @map("is_playing")
  endedReason     String?        @map("ended_reason")
  endedAt         DateTime?      @map("ended_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([userId, agentId, updatedAt(sort: Desc)], map: "music_co_listening_user_agent_updated_idx")
  @@index([workspaceId, updatedAt(sort: Desc)], map: "music_co_listening_workspace_updated_idx")
  @@index([status, updatedAt(sort: Desc)], map: "music_co_listening_status_updated_idx")
  @@map("music_co_listening_sessions")
}

model TimeCapsule {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String?        @map("agent_id")
  agent       AiAgent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspaceId String?        @map("workspace_id")
  workspace   ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title       String?
  content     String
  media       Json?
  skin        String         @default("paper")
  openDate    DateTime?      @map("open_date")
  status      String         @default("draft") // "draft" | "sealed"; opening requires explicit user action.
  sealedAt    DateTime?      @map("sealed_at")
  openedAt    DateTime?      @map("opened_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([userId, status, openDate], map: "time_capsules_user_state_idx")
  @@index([userId, openedAt], map: "time_capsules_user_opened_idx")
  @@index([userId, agentId, status, openDate], map: "time_capsules_user_agent_state_idx")
  @@index([workspaceId, status, openDate], map: "time_capsules_workspace_state_idx")
  @@map("time_capsules")
}

model LastWill {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String?            @map("agent_id")
  agent          AiAgent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workspaceId    String?            @map("workspace_id")
  workspace      ChatWorkspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  content        String
  inactivityDays Int                @default(30) @map("inactivity_days") // DB CHECK: 5..365
  contacts       Json               @default("[]") // DB CHECK: JSON array, max 3
  status         String             @default("draft") // DB CHECK: draft | active | paused | triggered | cancelled
  startedAt      DateTime?          @map("started_at")
  triggeredAt    DateTime?          @map("triggered_at")
  deliveredAt    DateTime?          @map("delivered_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deliveries     LastWillDelivery[]

  @@unique([userId], map: "last_wills_user_unique")
  @@index([userId, status], map: "last_wills_user_status_idx")
  @@index([status, startedAt], map: "last_wills_status_started_idx")
  @@map("last_wills")
}

model LastWillDelivery {
  id         String   @id @default(uuid())
  lastWillId String   @map("last_will_id")
  lastWill   LastWill @relation(fields: [lastWillId], references: [id], onDelete: Cascade)
  channel    String // DB CHECK: email | phone
  contact    Json
  dedupeKey  String   @map("dedupe_key")
  status     String   @default("pending") // DB CHECK: pending | sent | failed | cancelled
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([lastWillId, channel, dedupeKey], map: "last_will_deliveries_unique_contact_channel")
  @@index([status, createdAt], map: "last_will_deliveries_status_idx")
  @@map("last_will_deliveries")
}

model UserDailyActivity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  localDate   DateTime @map("local_date") @db.Date
  source      String
  seenCount   Int      @default(1) @map("seen_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, localDate], map: "user_daily_activity_user_date_key")
  @@index([userId, localDate], map: "user_daily_activity_user_date_idx")
  @@map("user_daily_activity")
}

model AchievementUnlock {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId       String         @map("agent_id")
  agent         AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId   String?        @map("workspace_id")
  workspace     ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  conversationId String?       @map("conversation_id")
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  achievementId Int            @map("achievement_id")
  metadata      Json           @default("{}")
  notifiedAt    DateTime?      @map("notified_at")
  unlockedAt    DateTime       @default(now()) @map("unlocked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([userId, agentId, achievementId], map: "achievement_unlocks_user_agent_achievement_key")
  @@index([userId, agentId, unlockedAt(sort: Desc)], map: "achievement_unlocks_user_agent_idx")
  @@map("achievement_unlocks")
}

model AchievementEvent {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId        String         @map("agent_id")
  agent          AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspaceId    String?        @map("workspace_id")
  workspace      ChatWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  conversationId String?        @map("conversation_id")
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  eventType      String         @map("event_type")
  sourceId       String?        @map("source_id")
  valueInt       Int?           @map("value_int")
  valueText      String?        @map("value_text")
  metadata       Json           @default("{}")
  occurredAt     DateTime       @default(now()) @map("occurred_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([userId, agentId, eventType, occurredAt(sort: Desc)], map: "achievement_events_scope_type_time_idx")
  @@index([workspaceId, eventType, occurredAt(sort: Desc)], map: "achievement_events_workspace_type_time_idx")
  @@map("achievement_events")
}

model PushDevice {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform      String
  provider      String    @default("apns")
  token         String
  environment   String    @default("sandbox")
  bundleId      String?   @map("bundle_id")
  deviceId      String?   @map("device_id")
  appVersion    String?   @map("app_version")
  enabled       Boolean   @default(true)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  disabledAt    DateTime? @map("disabled_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([provider, token], map: "push_devices_provider_token_key")
  @@index([userId, enabled, lastSeenAt(sort: Desc)], map: "push_devices_user_enabled_idx")
  @@index([userId, deviceId], map: "push_devices_user_device_idx")
  @@map("push_devices")
}

model NotificationEvent {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId            String?   @map("agent_id")
  workspaceId        String?   @map("workspace_id")
  conversationId     String?   @map("conversation_id")
  messageId          String?   @map("message_id")
  type               String
  title              String
  body               String
  payload            Json      @default("{}")
  dedupeKey          String    @map("dedupe_key")
  status             String    @default("pending")
  provider           String    @default("apns")
  providerMessageId  String?   @map("provider_message_id")
