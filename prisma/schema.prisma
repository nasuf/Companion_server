model UserMemory {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  workspaceId   String?        @map("workspace_id")
  workspace     ChatWorkspace? @relation(fields: [workspaceId], references: [id])
  type          String? // "identity", "emotion", "preference", "life", "thought", "consolidated"
  mainCategory  String?        @map("main_category")
  subCategory   String?        @map("sub_category")
  level         Int            @default(3)
  content       String
  importance    Float          @default(0.5)
  // Spec §1.5.2 L2 动态分 (importance × time × frequency × quality), 每日 cron
  // 现算写入. importance 保持"初始重要度"不可变 — 旧实现把动态分回写 importance
  // 造成逐日复利 (向上通胀/向下螺旋). 检索排序读 COALESCE(current_score, importance).
  currentScore  Float?         @map("current_score")
  // 惰性衰减 (AMV-L §3.2) 的时间基准: 上次重算 currentScore 的时刻。
  // 衰减量取决于经过的时间, 所以必须知道"上次算是什么时候"。不能复用 updatedAt
  // —— 那个字段被 admin 编辑/矛盾处理/访问打点等一堆写入刷新, 每刷一次 Δt 归零,
  // 记忆就永远衰减不下去。NULL 视为从未算过, 退回 createdAt。
  valueUpdatedAt DateTime?     @map("value_updated_at")
  // 记忆出处 (Phase 2): profile_seed / user_stated / ai_authored / daily_summary /
  // consolidated. 防御规则从"按类别猜出处"变"按列查": seed 行禁止写入期改写,
  // ai_authored 永不进人设类, daily_summary 供整合任务优先淘汰. NULL = 旧数据.
  provenance    String?        @map("provenance")
  mentionCount  Int            @default(0) @map("mention_count")
  isArchived    Boolean        @default(false) @map("is_archived")
  // Part 5 §3.1: occur_time = 事件实际发生时间 (= 时间解析器的 event_time)
  occurTime     DateTime?      @map("occur_time")
  // Part 5 §3.1: statement_time = 用户说出这句话的时间 (一般为消息接收时刻)
  statementTime DateTime?      @map("statement_time")
  // Part 5 §4.2: 提醒重复规则 once|yearly|monthly|weekly|daily; null=once 默认.
  // 部分索引 memories_user_reminder_idx 在 migration 20260502100000 手写 (Prisma
  // 不支持 partial index DSL), 改 schema 重生成时勿丢: WHERE sub_category='提醒'
  // AND is_archived=false. 索引 keys: (user_id, sub_category, recurrence).
  recurrence    String?        @map("recurrence")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("memories_user")
}

model AiMemory {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  workspaceId   String?        @map("workspace_id")
  workspace     ChatWorkspace? @relation(fields: [workspaceId], references: [id])
  type          String? // "identity", "emotion", "preference", "life", "thought", "consolidated"
  mainCategory  String?        @map("main_category")
  subCategory   String?        @map("sub_category")
  level         Int            @default(3)
  content       String
  importance    Float          @default(0.5)
  // Spec §1.5.2 L2 动态分 (同 UserMemory.currentScore, 注释见上).
  currentScore  Float?         @map("current_score")
  // 惰性衰减 (AMV-L §3.2) 的时间基准: 上次重算 currentScore 的时刻。
  // 衰减量取决于经过的时间, 所以必须知道"上次算是什么时候"。不能复用 updatedAt
  // —— 那个字段被 admin 编辑/矛盾处理/访问打点等一堆写入刷新, 每刷一次 Δt 归零,
  // 记忆就永远衰减不下去。NULL 视为从未算过, 退回 createdAt。
  valueUpdatedAt DateTime?     @map("value_updated_at")
  // 记忆出处 (同 UserMemory.provenance, 注释见上).
  provenance    String?        @map("provenance")
  mentionCount  Int            @default(0) @map("mention_count")
  isArchived    Boolean        @default(false) @map("is_archived")
  // Part 5 §3.1: occur_time = 事件实际发生时间 (= 时间解析器的 event_time)
  occurTime     DateTime?      @map("occur_time")
  // Part 5 §3.1: statement_time = 用户说出这句话的时间 (一般为消息接收时刻)
  statementTime DateTime?      @map("statement_time")
  // Part 5 §4.2: 提醒重复规则 (同 UserMemory.recurrence, 注释见上).
  // 部分索引: memories_ai_reminder_idx — 同样手写, 改 schema 时勿丢.
  recurrence    String?        @map("recurrence")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("memories_ai")
}

