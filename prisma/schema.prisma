// 全局运行时配置 (admin "系统设置" 改, prod 起后可热更换模型而无需重启).
// 单行 (id 永远=1) 设计避免 0/N 行歧义. 字段 nullable 表示 "未设, 走 env 默认".
//
// 解析顺序 (services/runtime_config.resolve_config):
//   AgentConfigOverride.field → SystemConfig.field → settings.field (env)
//
// 改动通过 services/runtime_config.invalidate_caches() 触发 lru_cache 清理,
// 下条 LLM 调用按新值重建实例; 当前流式中的 chain 仍用旧模型完成 (无中断).
model SystemConfig {
  id                     Int      @id @default(1)
  onlineModel            Boolean? @map("online_model")
  // Legacy shared provider. New config resolves chat/small provider separately.
  remoteProvider         String?  @map("remote_provider")
  remoteChatProvider     String?  @map("remote_chat_provider")
  remoteSmallProvider    String?  @map("remote_small_provider")
  localChatModel         String?  @map("local_chat_model")
  localSmallModel        String?  @map("local_small_model")
  remoteChatModel        String?  @map("remote_chat_model")
  remoteSmallModel       String?  @map("remote_small_model")
  // Multimodal models (global only, no per-agent override).
  // null = fall back to env DOUBAO_VISION_MODEL / DASHSCOPE_ASR_MODEL.
  visionModel            String?  @map("vision_model")
  asrModel               String?  @map("asr_model")
  // Assistant speech output (global-only). Probability is an integer percent
  // in [0, 100]; null falls back to TTS_OUTPUT_PROBABILITY.
  ttsModel               String?  @map("tts_model")
  ttsOutputProbability   Int?     @map("tts_output_probability")
  // Web search for main replies (Ark Responses API web_search tool).
  // Global only; null = fall back to env WEB_SEARCH_ENABLED (default false).
  webSearchEnabled       Boolean? @map("web_search_enabled")
  // Default template agent that new users (e.g. WeChat Mini Program) are cloned
  // from at first login. null = fall back to env DEFAULT_TEMPLATE_AGENT_ID.
  defaultTemplateAgentId String?  @map("default_template_agent_id")
  // 霸王餐激活校验码功能开关: 关闭后所有校验码立即失效且不再生成 (admin 可切换).
  mealCodeEnabled        Boolean  @default(true) @map("meal_code_enabled")
  // 校验码生成锚点 (unix 秒): 每次「开启」时刷新 — 码与窗口计时都相对锚点推导,
  // 锚点一变旧码全部立即失效, 新码从满 5 分钟倒计时开始. null = 0 (绝对时间窗).
  mealCodeAnchor         BigInt?  @map("meal_code_anchor")
  // 线下真实世界模块主动推送开关 (admin 后台动态切换, 实时生效, 默认关闭).
  // 关闭后 offline trigger scan 跳过对应分支 + 手动/mock 接口拒绝创建;
  // 已有条目的读取/操作接口不受影响. 默认 false: 客户端 (H5) 无卡片 UI 前先暂停.
  offlineActivityEnabled Boolean  @default(false) @map("offline_activity_enabled")
  offlineGiftEnabled     Boolean  @default(false) @map("offline_gift_enabled")
  // 成就系统全局模式 (admin 后台动态切换): on / silent / off; NULL = 跟随
  // .env ACHIEVEMENT_MODE. silent = H5 静默计算 (解锁照常落库, 成就页/积分
  // 正常可用, 仅静默聊天成就提示与系统推送); off = 应急停算 (页面隐藏,
  // 日终 checkpoint 冻结). 热路径读取经 ~10s 进程内 TTL 缓存
  // (app/services/achievements/mode.py).
  achievementMode        String?  @map("achievement_mode")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ── 霸王餐 (free-meal voucher campaign) ──────────────────────────────
// 商家: 联系人姓名/手机号用于商家 H5
// 页自助身份确认 (二选一, 都可空 — 空则该商家无法自助登录, 仅 admin 可管理).
model MealMerchant {
  id           String        @id @default(uuid())
  name         String
  contactName  String?       @map("contact_name")
  contactPhone String?       @map("contact_phone")
  codeActive   Boolean       @default(true) @map("code_active")
  // 千味央厨归属: qwycMember = 该商家属于「千味央厨」品牌下的成员门店;
  // qwycGroup = 该商家是「千味央厨」总账号 (登录后看汇总, 不扫码核销).
  qwycMember   Boolean       @default(false) @map("qwyc_member")
  qwycGroup    Boolean       @default(false) @map("qwyc_group")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  vouchers     MealVoucher[]

  @@map("meal_merchants")
}

// 霸王餐券: 每用户一张 (userId unique), 状态机 inactive → activated → redeemed.
// 激活 = 输入服务员页的 5 分钟轮换校验码; 核销仅支持商家扫码.
// merchant onDelete SetNull: 商家删除后已核销记录保留 (统计口径不塌).
model MealVoucher {
  id          String        @id @default(uuid())
  userId      String        @unique @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String        @default("inactive")
  activatedAt DateTime?     @map("activated_at")
  redeemedAt  DateTime?     @map("redeemed_at")
  merchantId  String?       @map("merchant_id")
  merchant    MealMerchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status], map: "meal_vouchers_status_idx")
  @@index([merchantId], map: "meal_vouchers_merchant_idx")
  @@index([activatedAt], map: "meal_vouchers_activated_at_idx")
  @@map("meal_vouchers")
}

// 霸王餐核销失败记录: 当日核销总量已达上限 (先到先得, 超出 1000 份) 时, 用户
// 核销请求被拒绝, 在此留痕供后台「数据统计」查看谁没抢到. 每用户每自然日
// 每种 reason 只记 1 条 (服务层写入前去重), 便于按「人/券」口径统计.
// merchantId 保留为松引用 (无外键): 只作展示线索, 商家删除不影响历史失败记录.
model MealRedemptionFailure {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String?  @map("merchant_id")
  reason     String   @default("daily_cap")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "meal_redeem_failures_created_at_idx")
  @@index([userId], map: "meal_redeem_failures_user_idx")
  @@map("meal_redemption_failures")
}

// 单 agent 模型 override. 改了只影响该 agent, 其余仍走 SystemConfig/env.
// 字段 nullable: null = 不 override, fallback 上层. embedding 不在此表 — embedding
// 跨 agent 共享 vector store, 不允许 per-agent 模型 (embedding 改了已有向量失真).
model AgentConfigOverride {
  agentId             String   @id @map("agent_id")
  onlineModel         Boolean? @map("online_model")
  remoteProvider      String?  @map("remote_provider")
  remoteChatProvider  String?  @map("remote_chat_provider")
  remoteSmallProvider String?  @map("remote_small_provider")
  localChatModel      String?  @map("local_chat_model")
  localSmallModel     String?  @map("local_small_model")
  remoteChatModel     String?  @map("remote_chat_model")
  remoteSmallModel    String?  @map("remote_small_model")
  updatedAt           DateTime @updatedAt @map("updated_at")

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_config_overrides")
}

// 模型库 — admin "系统设置 → 模型库" 维护. system_config / agent_config_overrides
// 的 chat/small 字段从这里选 identifier, role-specific remote provider 用于消歧;
// pricing.estimate_cost_cny 也从这里取价格.
//
// 设计:
//   - identifier 是 SDK 用的 model id; 同一 provider 内唯一, 跨 provider 可重名
//   - provider 派生 local (ollama) / remote (dashscope/deepseek/ark/minimax) 分组
//   - enabled=false 软隐藏, 不影响已配置 (现有 system_config/agent override 仍指向它)
//   - 价格 nullable + Decimal(10,4) 元/1M tokens; 本地默认 0
//   - contextWindow / notes 留 hook 给未来 prompt budget / admin 备注
//
// 暂不支持删除 — 改 enabled=false 即可. 删了被引用会让 system_config 指 "幽灵 ID".
model ModelRegistry {
  id                        String   @id @default(uuid())
  identifier                String
  displayName               String?  @map("display_name")
  provider                  String // ollama | dashscope | deepseek | ark | minimax
  enabled                   Boolean  @default(true)
  // llm models participate in chat/small routing; tts models are exposed only
  // through the speech-output route.
  modelKind                 String   @default("llm") @map("model_kind")
  // per_million_tokens | per_10k_characters
  billingUnit              String   @default("per_million_tokens") @map("billing_unit")
  unitPriceCny             Float?   @map("unit_price_cny")
  contextWindow             Int?     @map("context_window")
  // Float (≈double precision) 而非 Decimal — prisma-client-py 的 Decimal 支持是
  // experimental, 启用要全局 flag. 本场景精度需求低 (元/1M tokens 4-5 位小数足够),
  // float 单次乘法误差远小于 1 分钱, 不影响计费统计.
  inputCostPerMillion       Float?   @map("input_cost_per_million")
  outputCostPerMillion      Float?   @map("output_cost_per_million")
  // prefix cache 命中部分的 input 单价 (DeepSeek 命中 ≈ 未命中 1/40-1/120).
  // NULL = 未配置 → 计费按未命中价保守估算.
  cachedInputCostPerMillion Float?   @map("cached_input_cost_per_million")
  notes                     String?
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([provider, identifier])
  @@index([provider, enabled])
  @@index([modelKind, enabled])
  @@map("model_registry")
}
